{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "my-web-app",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "2f3f3ff2-0c4a-4582-967a-3ff7886eef45","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "e23d62d4f28c4451bb944beba89792be" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
